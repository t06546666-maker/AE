# ─── WhatsApp Business — Meta Cloud API ─────────────────────────
# 1. Go to https://developers.facebook.com  → My Apps → Create App → Business
# 2. Add "WhatsApp" product to your app
# 3. Under WhatsApp → Getting Started, copy the temporary or permanent token
WA_

# 4. Copy the Phone Number ID (NOT the phone number itself)
WA_PHONE_ID=1111575818715254
WA_API_VERSION=v26.0
WA_APP_SECRET=your_meta_app_secret
WA_VERIFY_TOKEN=create_a_random_webhook_verify_token
WA_REGISTRATION_TEMPLATE=customer_welcome_qr
# Optional simplified QR template. When set, all registration and manual QR sends
# use an image header and body variables: customer name, customer ID, total points.
WA_QR_TEMPLATE=customer_qr_balance
WA_REWARD_TEMPLATE=reward_receipt
WA_MERCHANT_CREDENTIALS_TEMPLATE=merchant_account_ready
WA_OFFER_TEMPLATE=merchant_offer_v1
WA_MERCHANT_ORDER_TEMPLATE=merchant_new_order_v1
WA_CUSTOMER_ORDER_STATUS_TEMPLATE=customer_order_status_v1
WA_TEMPLATE_LANGUAGE=en
WA_REQUEST_TIMEOUT_MS=8000
# Generate a long random value and store the same value in Supabase Vault.
OFFER_QUEUE_SECRET=replace_with_a_long_random_secret
# Optional queue tuning. Allowed range: 1-50 recipients per claim.
OFFER_BATCH_SIZE=20
# customer_welcome_qr legacy body: name, merchant, customer ID, percentage, points earned, total points
# customer_qr_balance body: customer name, customer ID, total reward points
# reward receipt body: name, merchant, percentage number, order number, amount, points earned, total points
# merchant account-ready body: name, store, merchant ID, registered email
# offer template: dynamic image header; body: customer, merchant, title, description, expiry
# merchant new order body: merchant, request ID, customer name, customer phone, requested items
# customer order status body: customer name, request ID, merchant, order status

# ─── Server ──────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=
# Required for Capacitor Mobile App to connect to the backend
VITE_API_URL=https://www.affiliateae.co.in

# Supabase > Settings > API Keys
SUPABASE_URL=https://zrsjbgzkaxccetjahcy.supabase.co
