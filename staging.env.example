# Copy to .env.staging. Do not copy production .env or production credentials.
AE_ENV=staging
VITE_AE_ENV=staging
AE_STAGING_SUPABASE_REF=replace_with_new_20_letter_project_ref
AE_STAGING_FIREBASE_PROJECT=ae-staging-replace
AE_STAGING_PUSH_MODE=disabled
SUPABASE_URL=https://replace_with_new_project_ref.supabase.co
VITE_SUPABASE_URL=https://replace_with_new_project_ref.supabase.co
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FIREBASE_PROJECT_ID=ae-staging-replace
VITE_FIREBASE_AUTH_DOMAIN=ae-staging-replace.firebaseapp.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
CUSTOMER_JWT_SECRET=
